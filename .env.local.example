# Copy this to .env.local and fill in your values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# The Claude API key is stored as a Supabase Secret (not here)
# Run: supabase secrets set CLAUDE_API_KEY=sk-ant-xxxx

# LV Creative Canvas providers and centralized model registry (server-only)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_TEXT_MODEL=
GOOGLE_IMAGE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=
CREATIVE_CANVAS_DEFAULT_TEXT_PROVIDER=
CREATIVE_CANVAS_DEFAULT_IMAGE_PROVIDER=
CREATIVE_CANVAS_DISABLED_PROVIDERS=
CREATIVE_CANVAS_MAX_UPLOAD_MB=
CREATIVE_CANVAS_MONTHLY_BUDGET_USD=
CREATIVE_CANVAS_BUDGET_WARNING_PERCENT=
CREATIVE_CANVAS_MAX_CONCURRENT=
CREATIVE_CANVAS_REQUESTS_PER_MINUTE=
CREATIVE_CANVAS_PROVIDER_TIMEOUT_MS=

# Website Opportunity Audit uses a server-only PageSpeed secret. Never prefix it VITE_:
# supabase secrets set PAGESPEED_API_KEY=your-google-pagespeed-key
